@using SustainEats.Shared.Models

<div class="category-filter">
    <h5>Categories</h5>
    <ul>
        @foreach (var category in _rootCategories)
        {
            <li>
                <CategoryTreeView Category="category" />
            </li>
        }
    </ul>
</div>

@code {
    private List<Category> _rootCategories = new();

    protected override void OnInitialized()
    {
        // Using placeholder data since DbContext is removed
        _rootCategories = new List<Category>
        {
            new Category { Id = 1, Name = "Основни ястия", Children = new List<Category>
                {
                    new Category { Id = 2, Name = "Месни" },
                    new Category { Id = 3, Name = "Безмесни" }
                }
            },
            new Category { Id = 4, Name = "Салати" },
            new Category { Id = 5, Name = "Десерти" }
        };
    }
}
