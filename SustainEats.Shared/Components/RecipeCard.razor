@using SustainEats.Shared.Models

<div class="card h-100 recipe-card">
    <div style="height: 180px; overflow: hidden; background-color: #e0e0e0;">
        <img src="@($"https://source.unsplash.com/random/400x300/?food,dish&sig={Recipe.Id}")" 
             class="card-img-top" 
             style="width: 100%; height: 100%; object-fit: cover;" 
             alt="@Recipe.Title"
             onerror="this.src='/images/default-food.png'"> 
             </div>
    
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title text-truncate" title="@Recipe.Title">@Recipe.Title</h5>
            <span class="badge bg-success rounded-pill">@Recipe.TotalCalories kcal</span>
        </div>

        <div class="mb-3 text-muted small">
            <i class="bi bi-clock"></i> @Recipe.PreparationTime мин. &nbsp;|&nbsp; 
            <i class="bi bi-lightning-charge"></i> @Recipe.TotalProtein g прот.
        </div>

        <div class="mt-auto">
            <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Въглехидрати</span>
                <span>@Recipe.TotalCarbs g</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: @(Math.Min(Recipe.TotalCarbs, 100))%"></div>
            </div>
            
            <div class="d-flex justify-content-between small text-muted mb-1 mt-2">
                <span>Мазнини</span>
                <span>@Recipe.TotalFat g</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-info" role="progressbar" style="width: @(Math.Min(Recipe.TotalFat, 100))%"></div>
            </div>
        </div>
        
        <a href="/recipe/@Recipe.Id" class="btn btn-outline-success w-100 mt-3">
            Виж рецептата
        </a>
    </div>
</div>

@code {
    [Parameter] public Recipe Recipe { get; set; }
}