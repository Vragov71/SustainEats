@page "/recipe/{RecipeId:int}"

@using SustainEats.Shared.Models
@using SustainEats.Shared.Services
@inject IRecipeService RecipeService

@if (_recipe == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h3>@_recipe.Title</h3>

    <div class="row">
        <div class="col-md-8">
            <h5>Instructions</h5>
            <p>@_recipe.Instructions</p>

            <h5>Ingredients</h5>
            @if (_recipe.Ingredients != null)
            {
                <ul>
                    @foreach (var ingredient in _recipe.Ingredients)
                    {
                        <li>@ingredient.QuantityNeeded @ingredient.IngredientDefinition.BaseUnit - @ingredient.IngredientDefinition.Name</li>
                    }
                </ul>
            }
        </div>
        <div class="col-md-4">
            <h5>Macros</h5>
            <p><strong>Calories:</strong> @_recipe.TotalCalories.ToString("F0") kcal</p>
            <p><strong>Protein:</strong> @_recipe.TotalProtein.ToString("F1") g</p>
            <p><strong>Carbs:</strong> @_recipe.TotalCarbs.ToString("F1") g</p>
            <p><strong>Fat:</strong> @_recipe.TotalFat.ToString("F1") g</p>
        </div>
    </div>
}

@code {
    [Parameter]
    public int RecipeId { get; set; }

    private Recipe _recipe;

    protected override async Task OnInitializedAsync()
    {
        _recipe = await RecipeService.GetRecipeByIdAsync(RecipeId);
    }
}
