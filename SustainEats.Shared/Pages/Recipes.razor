@page "/recipes"
@page "/recipes/category/{CategoryId:int}"

@using Microsoft.EntityFrameworkCore
@using SustainEats.Shared.Components
@using SustainEats.Shared.Models
@inject AppDbContext DbContext

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-book-half text-success"></i> Кулинарна книга</h3>
    <a href="/create-recipe" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Нова рецепта
    </a>
</div>

<div class="row">
    <div class="col-lg-3 mb-4">
        <div class="card p-3">
            <h6 class="text-uppercase text-muted mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Категории</h6>
            <CategoryFilter />
        </div>
    </div>

    <div class="col-lg-9">
        @if (!_recipes.Any())
        {
            <div class="alert alert-info text-center p-5">
                <h4>Няма намерени рецепти</h4>
                <p>Опитайте да промените филтрите или добавете първата си рецепта.</p>
                <a href="/create-recipe" class="btn btn-primary mt-2">Създай рецепта</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var recipe in _recipes)
                {
                    <div class="col">
                        <RecipeCard Recipe="recipe" />
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int? CategoryId { get; set; }

    private List<Recipe> _recipes = new();

    protected override async Task OnParametersSetAsync()
    {
        var query = DbContext.Recipes.AsQueryable();

        if (CategoryId.HasValue)
        {
            // This is a simplified filter. A real implementation would need
            // to recursively find all recipe IDs under a given category.
            // For now, we'll just show all recipes.
        }

        _recipes = await query
            .Include(r => r.Ingredients)
            .ThenInclude(ri => ri.IngredientDefinition)
            .ToListAsync();
    }
}