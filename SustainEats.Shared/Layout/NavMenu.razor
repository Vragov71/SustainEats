@using Microsoft.AspNetCore.Components.Authorization
@using SustainEats.Shared.Services
@inject IAuthService AuthService
@inject NavigationManager NavManager

<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1b6ec2; padding: 0.8rem 1rem;">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center" href="">
            <i class="bi bi-basket3-fill me-2 fs-4"></i>
            <span style="letter-spacing: 1px;">SustainEats</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-bold gap-lg-4">
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="" Match="NavLinkMatch.All">
                        НАЧАЛО
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="inventory">
                        ИНВЕНТАР
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="recipes">
                        РЕЦЕПТИ
                    </NavLink>
                </li>
            </ul>

            <ul class="navbar-nav align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white d-flex align-items-center bg-white bg-opacity-10 rounded px-3 py-2" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-2"></i> 
                                @context.User.Identity?.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li><a class="dropdown-item" href="account"><i class="bi bi-gear me-2"></i>Моят Профил</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item text-danger" @onclick="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Изход
                                    </button>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item d-flex gap-2">
                            <a class="btn btn-outline-light px-3" href="login">Вход</a>
                            <a class="btn btn-light text-success fw-bold px-3" href="register">Регистрация</a>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

@code {
    private async Task Logout()
    {
        await AuthService.Logout();
        NavManager.NavigateTo("/login");
    }
}
